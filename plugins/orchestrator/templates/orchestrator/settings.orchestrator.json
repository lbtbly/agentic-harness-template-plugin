{
  "$comment": "HIGH-AUTONOMY profile for UNATTENDED Phase-B runs ONLY (claude -p --settings this-file, inside the sandbox/devcontainer with default-deny egress). The committed team settings.json (plan-mode, bypass disabled) is UNTOUCHED. Isolation + permissions.deny are the HARD controls; the security hooks below are defense-in-depth and resolve via $ORCH_CORE_HOOKS (the runtime exports it to the core plugin's hooks/ dir). The native OS sandbox is enabled on top (DEVIATIONS.md §5); failIfUnavailable stays false because the devcontainer is the outer wall on runners where the OS sandbox is missing. enabledMcpjsonServers pins exactly the playwright MCP for the browser-verify step. sandbox.network.allowedDomains mirrors orchestrator/egress-allowlist.txt (single source — parity-tested with the devcontainer firewall); sandbox.credentials denies the model/delivery credentials to tool subprocesses (the CLI itself reads them from its own env; Bash tools never need them — GH_TOKEN stays visible because gh runs in Bash).",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(orchestrator/**)",
      "Write(orchestrator/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(glab mr merge:*)"
    ],
    "allow": [
      "Read(./.env.example)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push origin orch/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(glab ci:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr update:*)",
      "Bash(glab mr view:*)",
      "Bash(glab mr list:*)",
      "Bash(bash tests/run-tests.sh)",
      "Bash(bash orchestrator/bin/orch:*)",
      "Bash(bash orchestrator/adapters/deploy.sh:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SLACK_WEBHOOK_URL",
          "mode": "deny"
        },
        {
          "name": "SLACK_BOT_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SENDGRID_API_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$ORCH_CORE_HOOKS/secret-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$ORCH_CORE_HOOKS/block-no-verify.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$ORCH_CORE_HOOKS/protect-paths.sh\""
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ]
}

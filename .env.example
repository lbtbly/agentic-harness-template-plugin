# ============================================================
# Environment variables — TEMPLATE. Names only, never values.
# Copy to .env (gitignored) and fill in locally.
# ============================================================

# --- run notifications (optional) ---------------------------
# Slack bot token for orchestrator/adapters/notify-slack.sh.
# Bot scopes: chat:write, chat:write.public, channels:manage, channels:read.
# The loop posts one channel per project: cchar-<repo>, created on first use.
#
# Prefer exporting this in your shell profile rather than copying it into every
# project's .env — one token, one place to rotate. A project .env overrides it.
#
# Unset is the normal case: the adapter no-ops silently and the run is unaffected.
# SLACK_BOT_TOKEN=

# Override the derived channel (default: cchar-<repo-basename>, slugified)
# ORCH_SLACK_CHANNEL=
# Override just the prefix (default: cchar-)
# ORCH_SLACK_PREFIX=

# NOTE: inside the sandbox, slack.com must be uncommented in
# orchestrator/egress-allowlist.txt AND mirrored into settings.orchestrator.json
# and .devcontainer/init-firewall.sh, or every notification fails closed.
